# Environment Variables Template
# Copy this file to .env.local and update the values

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Email Configuration (Required for contact form)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Cal.com Configuration
CALCOM_USERNAME=eduworkflow
NEXT_PUBLIC_CALCOM_USERNAME=eduworkflow
NEXT_PUBLIC_CALCOM_EVENT_TYPE=intro

# Analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com

# A/B Testing (optional)
EXPERIMENT_VARIANT=A

# Optional Alternative Booking Services
# NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-username/intro

# Email Service Alternatives (choose one)
# Option 1: Gmail SMTP (recommended for simplicity)
# Use SMTP_* variables above

# Option 2: Resend (for professional email sending)
# RESEND_API_KEY=your_resend_api_key

# Option 3: SendGrid
# SENDGRID_API_KEY=your_sendgrid_api_key
